# UniVerse React Web v1 — Environment Variables
# Copy to .env.local for local development (never commit .env.local)

# Supabase project URL and anon key (staging recommended during development)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Python FastAPI OR-Tools CP-SAT engine base URL (root GET / serves health check)
VITE_TIMETABLE_BASE_URL=https://universe-timetable-engine.onrender.com

# Keep false in production builds; /preview/scheduling remains gated behind admin auth
VITE_ENABLE_SCHEDULING_PREVIEW_ROUTE=false
